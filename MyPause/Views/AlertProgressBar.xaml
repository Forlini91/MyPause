<UserControl x:Class="MyPause.Views.AlertProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="1"
             MinWidth="1"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="56"/>
        </Grid.ColumnDefinitions>

        <ProgressBar x:Name="ProgressBarControl"
                     Grid.Column="0"
                     Height="6"
                     Background="LightGray"
                     Foreground="DarkGray"
                     Value="0"
                     Maximum="100"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"/>

        <TextBlock x:Name="RemainingLabel"
                   Grid.Column="1"
                   Text=""
                   TextAlignment="Right"
                   FontSize="11"
                   Foreground="DimGray"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"/>
    </Grid>
</UserControl>
