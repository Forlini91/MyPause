<Window x:Class="MyPause.Views.EditPauseWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:res="clr-namespace:MyPause.Resources"
		Title="{x:Static res:Strings.EditPause_Title}"
		Height="640"
		Width="420"
		WindowStartupLocation="CenterScreen"
		Background="#F5F5F5"
		ResizeMode="NoResize"
		Loaded="OnLoaded"
		Unloaded="OnUnloaded"
		PreviewKeyDown="OnPreviewKeyDown">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
			<StackPanel>

				<!-- Attiva (in cima) -->
				<CheckBox x:Name="IsActiveCheckBox" Content="{x:Static res:Strings.EditPause_Active}" IsChecked="True" FontWeight="Bold" Margin="0,0,0,15"/>

				<!-- Nome -->
				<StackPanel Margin="0,0,0,12">
					<TextBlock Text="{x:Static res:Strings.EditPause_Name}" FontWeight="Bold" Margin="0,0,0,4"/>
					<TextBox x:Name="NameTextBox" Padding="7,5" Background="White" BorderBrush="#CCC" BorderThickness="1"/>
				</StackPanel>

				<!-- Giorni attivi -->

				<!-- Giorni Attivi -->
				<Grid Margin="0,0,0,12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBlock Text="{x:Static res:Strings.EditPause_Days}" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"/>
					<CheckBox x:Name="LunCheckBox" Content="{x:Static res:Strings.EditPause_DayMon}" FontSize="12" Grid.Column="1" Margin="0,0,12,0"/>
					<CheckBox x:Name="MarCheckBox" Content="{x:Static res:Strings.EditPause_DayTue}" FontSize="12" Grid.Column="2" Margin="0,0,12,0"/>
					<CheckBox x:Name="MerCheckBox" Content="{x:Static res:Strings.EditPause_DayWed}" FontSize="12" Grid.Column="3" Margin="0,0,12,0"/>
					<CheckBox x:Name="GioCheckBox" Content="{x:Static res:Strings.EditPause_DayThu}" FontSize="12" Grid.Column="4" Margin="0,0,12,0"/>
					<CheckBox x:Name="VenCheckBox" Content="{x:Static res:Strings.EditPause_DayFri}" FontSize="12" Grid.Column="5" Margin="0,0,12,0"/>
					<CheckBox x:Name="SabCheckBox" Content="{x:Static res:Strings.EditPause_DaySat}" FontSize="12" Grid.Column="6" Margin="0,0,12,0"/>
					<CheckBox x:Name="DomCheckBox" Content="{x:Static res:Strings.EditPause_DaySun}" FontSize="12" Grid.Column="7" Margin="0,0,12,0"/>
				</Grid>

				<!-- Schedule TabControl -->
				<TabControl x:Name="ScheduleTabControl" Margin="0,0,0,12">
					<TabItem Header="{x:Static res:Strings.EditPause_TabFixedTime}">
						<Grid Margin="10,10,10,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{x:Static res:Strings.EditPause_Time}" VerticalAlignment="Center" FontSize="12"/>
							<StackPanel Orientation="Horizontal" Grid.Column="1">
								<TextBox x:Name="FixedTimeHourBox" Text="10" Width="45" Padding="6,4" Background="White" BorderBrush="#CCC" BorderThickness="1" TextAlignment="Center"/>
								<StackPanel Width="20" Margin="2,0,0,0">
									<RepeatButton Content="&#x25B2;" Height="14" FontSize="8" Padding="0" Click="HourUp_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
									<RepeatButton Content="&#x25BC;" Height="14" FontSize="8" Padding="0" Click="HourDown_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
								</StackPanel>
								<TextBlock Text=":" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="6,0"/>
								<TextBox x:Name="FixedTimeMinuteBox" Text="30" Width="45" Padding="6,4" Background="White" BorderBrush="#CCC" BorderThickness="1" TextAlignment="Center"/>
								<StackPanel Width="20" Margin="2,0,0,0">
									<RepeatButton Content="&#x25B2;" Height="14" FontSize="8" Padding="0" Click="MinuteUp_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
									<RepeatButton Content="&#x25BC;" Height="14" FontSize="8" Padding="0" Click="MinuteDown_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
								</StackPanel>
							</StackPanel>
						</Grid>
					</TabItem>
					<TabItem Header="{x:Static res:Strings.EditPause_TabTimer}">
						<Grid Margin="10,10,10,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="55"/>
								<ColumnDefinition Width="22"/>
								<ColumnDefinition Width="80"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{x:Static res:Strings.EditPause_Every}" VerticalAlignment="Center" FontSize="12"/>
							<StackPanel Orientation="Horizontal" Grid.Column="1" Grid.ColumnSpan="2">
								<TextBox x:Name="TimerValueTextBox" Text="60" Width="45" Padding="6,4" Background="White" BorderBrush="#CCC" BorderThickness="1" TextAlignment="Center"/>
								<StackPanel Width="20" Margin="2,0,0,0">
									<RepeatButton Content="&#x25B2;" Height="14" FontSize="8" Padding="0" Click="TimerValueUp_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
									<RepeatButton Content="&#x25BC;" Height="14" FontSize="8" Padding="0" Click="TimerValueDown_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
								</StackPanel>
							</StackPanel>
							<ComboBox x:Name="TimerUnitBox" Grid.Column="3" Padding="6,4"/>
						</Grid>
					</TabItem>
				</TabControl>

				<CheckBox x:Name="MandatoryPauseCheckBox" Content="{x:Static res:Strings.EditPause_Mandatory}" IsChecked="True" FontSize="12" Margin="0,8,0,0"/>

				<!-- Durata pausa con spinner -->
				<Grid Margin="0,0,0,12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="80"/>
					</Grid.ColumnDefinitions>
					<TextBlock Text="{x:Static res:Strings.EditPause_PauseDuration}" FontWeight="Bold" VerticalAlignment="Center"/>
					<StackPanel Orientation="Horizontal" Grid.Column="1">
						<TextBox x:Name="PauseDurationTextBox" Text="5" Width="55" Padding="6,4" Background="White" BorderBrush="#CCC" BorderThickness="1" TextAlignment="Center"/>
						<StackPanel Width="20" Margin="2,0,0,0">
							<RepeatButton Content="▲" Height="14" FontSize="8" Padding="0" Click="PauseDurationUp_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
							<RepeatButton Content="▼" Height="14" FontSize="8" Padding="0" Click="PauseDurationDown_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
						</StackPanel>
					</StackPanel>
					<ComboBox x:Name="PauseDurationUnitBox" Grid.Column="2" Padding="6,4" Margin="8,0,0,0"/>
				</Grid>

				<!-- Snooze Config -->
				<Border Background="White" Margin="0,0,0,12" BorderBrush="#DDD" BorderThickness="1" Padding="10,8">
					<StackPanel>
						<TextBlock Text="{x:Static res:Strings.EditPause_Snooze}" FontWeight="Bold" Margin="0,0,0,8"/>
						<Grid Margin="0,0,0,6">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="55"/>
								<ColumnDefinition Width="22"/>
								<ColumnDefinition Width="80"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="6"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<TextBlock Text="{x:Static res:Strings.EditPause_SnoozeDuration}" FontSize="12" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
							<TextBox x:Name="SnoozeMinutesTextBox" Text="10" Padding="5,4" Background="#FFF" BorderBrush="#CCC" BorderThickness="1" Grid.Row="0" Grid.Column="1" TextAlignment="Center"/>
							<StackPanel Width="20" Margin="2,0,0,0" Grid.Row="0" Grid.Column="2">
								<RepeatButton Content="&#x25B2;" Height="14" FontSize="8" Padding="0" Click="SnoozeMinutesUp_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
								<RepeatButton Content="&#x25BC;" Height="14" FontSize="8" Padding="0" Click="SnoozeMinutesDown_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
							</StackPanel>
							<ComboBox x:Name="SnoozeUnitBox" Grid.Row="0" Grid.Column="3" Padding="6,4" Margin="8,0,0,0"/>
							<TextBlock Text="{x:Static res:Strings.EditPause_MaxSnoozes}" FontSize="12" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
							<TextBox x:Name="MaxSnoozeCountTextBox" Text="3" Padding="5,4" Background="#FFF" BorderBrush="#CCC" BorderThickness="1" Grid.Row="2" Grid.Column="1" TextAlignment="Center"/>
							<StackPanel Width="20" Margin="2,0,0,0" Grid.Row="2" Grid.Column="2">
								<RepeatButton Content="&#x25B2;" Height="14" FontSize="8" Padding="0" Click="MaxSnoozeCountUp_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
								<RepeatButton Content="&#x25BC;" Height="14" FontSize="8" Padding="0" Click="MaxSnoozeCountDown_Click" Background="#EEE" BorderBrush="#CCC" BorderThickness="1"/>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>

				<!-- Notification Sound -->
				<Border Background="White" Margin="0,0,0,12" BorderBrush="#DDD" BorderThickness="1" Padding="10,8">
					<StackPanel>
						<TextBlock Text="{x:Static res:Strings.EditPause_NotificationSound}" FontWeight="Bold" Margin="0,0,0,8"/>
						<TextBlock x:Name="SoundFileLabel" Text="{x:Static res:Strings.EditPause_NoSoundSelected}" FontSize="12" Foreground="#666" Margin="0,0,0,6" TextWrapping="Wrap"/>
						<StackPanel Orientation="Horizontal">
							<Button x:Name="SelectSoundButton" Content="{x:Static res:Strings.EditPause_SelectAudioFile}" Padding="8,6" Background="#3498DB" Foreground="White" Click="SelectSoundButton_Click" Cursor="Hand" Margin="0,0,8,0"/>
							<Button x:Name="ClearSoundButton" Content="{x:Static res:Strings.EditPause_ResetDefault}" Padding="8,6" Background="#6C757D" Foreground="White" Click="ClearSoundButton_Click" Cursor="Hand"/>
						</StackPanel>
					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>

		<!-- Pulsanti in fondo -->
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" Margin="0,15,0,0">
		<Button Content="{x:Static res:Strings.EditPause_Save}" Padding="12,7" Background="#27AE60" Foreground="White" Click="SaveButton_Click" Cursor="Hand" Margin="0,0,10,0"/>
		<Button Content="{x:Static res:Strings.EditPause_Cancel}" Padding="12,7" Background="#6C757D" Foreground="White" Click="CancelButton_Click" Cursor="Hand"/>
		</StackPanel>
	</Grid>
</Window>
