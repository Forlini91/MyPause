<Window x:Class="MyPause.Views.PauseNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:MyPause.Views"
        xmlns:res="clr-namespace:MyPause.Resources"
        Title="{x:Static res:Strings.PauseNotification_Title}"
        WindowStyle="None"
        Background="#2D2D2D"
        Foreground="White"
        Width="500"
        Height="350"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        AllowsTransparency="True"
		Loaded="OnLoaded"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown"
        Unloaded="OnUnloaded">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
            <TextBlock Text="{x:Static res:Strings.PauseNotification_Header}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#FF6B6B"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>

            <StackPanel x:Name="ContentStackPanel" Margin="0,0,0,0">
                <TextBlock x:Name="AlertNameText"
                          FontSize="16"
                          TextAlignment="Center"
                          Margin="0,0,0,8"/>
                <TextBlock x:Name="DurationText"
                          FontSize="14"
                          Foreground="#CCCCCC"
                          TextAlignment="Center"
                          Margin="0,0,0,8"/>
                <TextBlock x:Name="CountdownText"
                          FontSize="48"
                          FontWeight="Bold"
                          Foreground="#4ECDC4"
                          TextAlignment="Center"
                          Margin="0,0,0,12"/>

                <Grid x:Name="ProgressBarContainer"
                      Width="360"
                      Margin="0,0,0,20"/>
            </StackPanel>

            <Separator Background="#444444" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
				<Button x:Name="SnoozeButton"
				    Content="{x:Static res:Strings.PauseNotification_Snooze}"
					Padding="15,10"
					Background="#FFD93D"
					Foreground="#2D2D2D"
					FontWeight="Bold"
					Click="SnoozeButton_Click"
					Cursor="Hand"
					Margin="0,0,10,0"/>

				<Button x:Name="CompleteButton"
				    Content="{x:Static res:Strings.PauseNotification_Skip}"
					Padding="15,10"
					Background="#51CF66"
					Foreground="White"
					FontWeight="Bold"
					Click="SkipButton_Click"
					Cursor="Hand"/>
            </StackPanel>

            <TextBlock x:Name="SnoozeCountText"
                      FontSize="12"
                      Foreground="#CCCCCC"
                      TextAlignment="Center"
                      Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
