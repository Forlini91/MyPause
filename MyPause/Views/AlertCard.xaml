<UserControl x:Class="MyPause.Views.AlertCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MyPause.Views"
             MinHeight="1"
             MinWidth="0"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             HorizontalAlignment="Stretch">
        <Border x:Name="CardBorder"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="8"
            Margin="0,0,0,10"
            Padding="12"
            Background="White"
            Cursor="Arrow"
            HorizontalAlignment="Stretch"
            MinWidth="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,0,0">
                    <TextBlock x:Name="TitleText"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="Black"/>

                    <TextBlock x:Name="DescriptionText"
                           FontSize="11"
                           Foreground="Gray"/>
            </StackPanel>

                <Ellipse x:Name="StatusIndicator"
                         Grid.Column="1"
                     Width="16"
                     Height="16"
                     Fill="LightGray"
                     VerticalAlignment="Center"
                     Margin="10,0,0,0"/>

                <Grid Grid.Column="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Margin="15,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StartStopButton"
                            Grid.Column="0"
                            Padding="6"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            Foreground="#16A085"
                            Click="StartStopButton_Click"
                            Cursor="Hand"
                            Margin="0,0,6,0"
                            Content="▶"/>

                    <Button x:Name="EditButton"
                            Grid.Column="1"
                            Padding="6"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            Foreground="#3498DB"
                            Click="EditButton_Click"
                            Cursor="Hand"
                            Margin="0,0,6,0"
                            Content="✎"/>

                    <Button x:Name="DeleteButton"
                            Grid.Column="2"
                            Padding="6"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            Foreground="#E74C3C"
                            Click="DeleteButton_Click"
                            Cursor="Hand"
                            Content="🗑"/>
                </Grid>
            </Grid>

            <Grid x:Name="ProgressRow"
                  Grid.Row="1"
                  Margin="0,8,0,0">
            </Grid>
        </Grid>
    </Border>
</UserControl>
